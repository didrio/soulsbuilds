{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    // scripts/data/*.ts run directly under Node 24 (type stripping): imports keep their .ts extension
    // and only erasable syntax is allowed (no enums, namespaces or parameter properties).
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["vite/client", "node"]
  },
  "include": [
    "src",
    "scripts",
    "tests",
    "vite.config.ts",
    "vitest.emulator.config.ts",
    "playwright.config.ts"
  ],
  "exclude": ["scripts/legacy-data", "dist", "node_modules"]
}
