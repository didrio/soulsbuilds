{
  "name": "soulsbuilds",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/firebase.mjs emulators:exec --project demo-soulsbuilds --only auth,firestore --ui \"node scripts/seed.mjs && vite\"",
    "dev:vite": "vite",
    "emulators": "node scripts/firebase.mjs emulators:start --project demo-soulsbuilds --only auth,firestore",
    "seed": "node scripts/seed.mjs",
    "data": "node scripts/data/build.ts",
    "build": "vite build",
    "preview": "vite preview",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p functions",
    "build:functions": "node scripts/build-functions.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "node scripts/firebase.mjs --config firebase.test.json emulators:exec --project demo-soulsbuilds-test --only firestore,auth \"vitest run --config vitest.emulator.config.ts\"",
    "e2e": "node scripts/e2e.mjs",
    "screenshot": "node scripts/screenshot.mjs",
    "perf": "node scripts/perf.mjs",
    "doctor": "node scripts/doctor.mjs",
    "deploy": "npm run check && node scripts/firebase.mjs deploy --project soulsbuilds --only functions,hosting"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@reduxjs/toolkit": "^2.14.0",
    "@tanstack/react-query": "^5.107.1",
    "@uiw/react-md-editor": "^4.2.3",
    "firebase": "^13.3.0",
    "nanoid": "^5.1.16",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-redux": "^9.3.1",
    "react-router": "^7.18.5",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "styled-components": "^6.6.0"
  },
  "allowScripts": {
    "@firebase/util": false,
    "protobufjs": false,
    "re2": false,
    "fsevents": false
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@eslint/js": "^9.39.5",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.65.1",
    "@rolldown/plugin-babel": "^0.3.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-admin": "^14.5.1",
    "firebase-tools": "^15.36.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "playwright-core": "^1.65.1",
    "prettier": "^3.10.1",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sharp": "^0.35.5",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.2",
    "unified": "^11.0.5",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  }
}
