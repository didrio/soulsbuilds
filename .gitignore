# Dependencies
node_modules/

# Build output
dist/
coverage/

# Agent and tool artifacts (screenshots, scratch output)
.artifacts/

# scripts/admin.mjs backups of removed content (user data: never commit)
.admin-backups/

# Link-preview function (T37): built by `npm run build:functions`
functions/lib/
functions/fonts/

# Firebase local state
.firebase/
.firebaserc.local
.emulator-data/
*-debug.log
firebase-debug.*.log

# Secrets: never commit credentials. Admin scripts use Application Default Credentials.
serviceAccount*.json
*service-account*.json
*credentials*.json
.env
.env.*
!.env.example

# Editors / OS
.DS_Store
.idea/
*~

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Only npm is used (package-lock.json is committed)
yarn.lock
pnpm-lock.yaml

# Personal Claude Code settings
.claude/settings.local.json

# The owner's game-data export (FromSoftware's files, ~3 GB) lives outside the repo at
# ~/Documents/soulsbuilds-gamedata; these catch it if it's ever unzipped here by mistake. Never commit it.
/soulsbuilds-gamedata/
/soulsbuilds-export/

# npm run perf results and traces (T21)
.perf/
