rules_version = '2';

// Firestore security rules for data model v2 (T3). The model is documented in docs/architecture.md
// "Firestore model (v2)"; tests/rules/ covers every rule (`npm run test:rules`).
// Production still has the expired 2022 rules (deny all). Deploying this file is a T12 step, with
// the owner.
//
// Counters: `likeCount` and `commentCount` on a build only change by exactly 1, in the same batched
// write that creates or deletes the matching like/comment doc (no Cloud Functions: they need the
// paid Blaze plan). See likeChange() / commentChange() and the subcollection rules.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helpers -------------------------------------------------------------------------------

    function signedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Admins are marked with a custom claim set by an admin script, never by a client-writable field.
    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function hasExactly(data, keys) {
      return data.keys().hasAll(keys) && data.keys().hasOnly(keys);
    }

    // A trimmed, non-empty string of at most `max` characters.
    function isText(value, max) {
      return value is string && value.size() >= 1 && value.size() <= max && value == value.trim();
    }

    // A document id the app generates (Firestore auto-ids) or the seed uses.
    function isId(value) {
      return value is string && value.matches('^[A-Za-z0-9_-]{1,40}$');
    }

    function buildPath(buildId) {
      return /databases/$(database)/documents/builds/$(buildId);
    }

    // ---- users/{uid}: public profile -----------------------------------------------------------
    // Email stays in Firebase Auth only; nothing private is stored in Firestore.

    match /users/{userId} {
      allow read: if true;
      allow create: if isUser(userId)
        && hasExactly(incoming(), ['displayName', 'createdAt'])
        && isText(incoming().displayName, 40)
        && incoming().createdAt == request.time;
      allow update: if isUser(userId)
        && changedKeys().hasOnly(['displayName'])
        && isText(incoming().displayName, 40);
      // Account deletion (T18): the last Firestore step before the Auth account goes.
      allow delete: if isUser(userId);

      // users/{uid}/tracking/{buildId}: the player's private progress on a build (T34). Only they
      // read or write it. Item keys and stats are the app's job beyond their shape. startedAt is set
      // by the client (progress from local storage keeps its real start) and may only move earlier
      // (merging this device's progress into the account's on sign-in).
      match /tracking/{buildId} {
        allow read, delete: if isUser(userId);
        allow create: if isUser(userId) && validTracking(buildId, incoming());
        allow update: if isUser(userId) && validTracking(buildId, incoming())
          && incoming().startedAt <= resource.data.startedAt;
      }
    }

    function validTracking(buildId, t) {
      return isId(buildId)
        && hasExactly(t, ['game', 'collected', 'seen', 'stats', 'startedAt', 'updatedAt',
          'completedAt'])
        && t.game == 'elden-ring'
        && t.collected is list && t.collected.size() <= 64
        && t.seen is list && t.seen.size() <= 64
        && validStats(t.stats)
        && t.startedAt is timestamp
        && t.updatedAt == request.time
        && (t.completedAt == null || t.completedAt is timestamp);
    }

    // ---- builds/{id} ---------------------------------------------------------------------------

    function isStat(value) {
      return value is int && value >= 1 && value <= 99;
    }

    function validStats(s) {
      return s is map
        && hasExactly(s, ['vigor', 'mind', 'end', 'str', 'dex', 'int', 'fai', 'arc'])
        && isStat(s.vigor) && isStat(s.mind) && isStat(s.end) && isStat(s.str)
        && isStat(s.dex) && isStat(s.int) && isStat(s.fai) && isStat(s.arc);
    }

    // Level = sum of the 8 stats - 79, never below 1 (src/lib/buildMath.ts calculateLevel).
    function validLevel(level, s) {
      return level is int && (
        (s.vigor + s.mind + s.end + s.str + s.dex + s.int + s.fai + s.arc - 79 >= 1
          && level == s.vigor + s.mind + s.end + s.str + s.dex + s.int + s.fai + s.arc - 79)
        || (s.vigor + s.mind + s.end + s.str + s.dex + s.int + s.fai + s.arc - 79 < 1
          && level == 1));
    }

    // Items are game IDs (param row IDs in src/data/er/; each field implies the file). Positional
    // lists (weapons, their affinities and Ashes of War, arrows) have a fixed length and null for an
    // empty slot. Whether an ID exists or fits its weapon is the app's job (it ignores unknown IDs).
    //
    // Budget: Firestore evaluates at most ~1,000 expressions per request and denies without detail
    // beyond that. Every reference to a list re-walks request.resource.data…, so one entry check
    // costs ~25: checking all 42 list entries would blow it. So the positional lists, the single
    // slots and the affinities are type-checked, and the talisman/spell/tear/consumable lists only
    // by size, like every list in 2022 (docs/decisions.md). The full-equipment test in
    // tests/rules/firestore.rules.test.ts guards the worst case.
    function isItemIdOrNull(value) {
      return value == null || value is int;
    }

    function slots4(l) {
      return l is list && l.size() == 4
        && (l[0] == null || l[0] is int) && (l[1] == null || l[1] is int)
        && (l[2] == null || l[2] is int) && (l[3] == null || l[3] is int);
    }

    function slots6(l) {
      return l is list && l.size() == 6
        && (l[0] == null || l[0] is int) && (l[1] == null || l[1] is int)
        && (l[2] == null || l[2] is int) && (l[3] == null || l[3] is int)
        && (l[4] == null || l[4] is int) && (l[5] == null || l[5] is int);
    }

    // A weapon's affinity per slot; Standard is stored as null.
    function affinities6(l) {
      return l is list && l.size() == 6 && [null, 'heavy', 'keen', 'quality', 'fire', 'flame-art',
        'lightning', 'sacred', 'magic', 'cold', 'poison', 'blood', 'occult'].hasAll(l);
    }

    function validEquipment(e) {
      return e is map
        && hasExactly(e, ['weapons', 'weaponAffinities', 'weaponSkills', 'arrows', 'talismans',
          'spells', 'tears', 'consumables', 'helm', 'chest', 'gauntlet', 'leg', 'greatRune',
          'spiritAsh'])
        && slots6(e.weapons) && affinities6(e.weaponAffinities) && slots6(e.weaponSkills)
        && slots4(e.arrows)
        && e.talismans is list && e.talismans.size() <= 4
        && e.spells is list && e.spells.size() <= 12
        && e.tears is list && e.tears.size() <= 2
        && e.consumables is list && e.consumables.size() <= 10
        && isItemIdOrNull(e.helm) && isItemIdOrNull(e.chest) && isItemIdOrNull(e.gauntlet)
        && isItemIdOrNull(e.leg) && isItemIdOrNull(e.greatRune) && isItemIdOrNull(e.spiritAsh);
    }

    // The fields the owner writes. Everything else is set on create or changed by the counters.
    function contentKeys() {
      return ['name', 'nameLower', 'description', 'tags', 'level', 'stats', 'equipment',
        'startingClass'];
    }

    // A starting class is its CharaInitParam ID (3000 Vagabond … 3009 Wretch) or null for none; builds
    // from before T8 don't have the field. The class's minimum stats are the app's job (budget).
    function validStartingClass(d) {
      return !('startingClass' in d) || d.startingClass == null
        || (d.startingClass is int && d.startingClass >= 3000 && d.startingClass <= 3009);
    }

    function validContent(d) {
      return isText(d.name, 80)
        && d.nameLower == d.name.lower()
        && d.description is string && d.description.size() <= 20000
        && d.tags is list && d.tags.size() <= 20
        && validStats(d.stats)
        && validLevel(d.level, d.stats)
        && validStartingClass(d)
        && validEquipment(d.equipment);
    }

    match /builds/{buildId} {
      allow read: if true;

      allow create: if signedIn()
        && hasExactly(incoming(), contentKeys().concat(
          ['ownerId', 'game', 'likeCount', 'commentCount', 'createdAt', 'updatedAt']))
        && incoming().ownerId == request.auth.uid
        && incoming().game == 'elden-ring'
        && validContent(incoming())
        && incoming().likeCount == 0
        && incoming().commentCount == 0
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if ownerEdit() || likeChange(buildId) || commentChange(buildId);

      // Likes and comments are deleted afterwards (see the orphan rules below).
      allow delete: if signedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());

      // The owner edits the content and must bump updatedAt; never ownerId, game, counts or createdAt.
      function ownerEdit() {
        return signedIn()
          && resource.data.ownerId == request.auth.uid
          && changedKeys().hasOnly(contentKeys().concat(['updatedAt']))
          && validContent(incoming())
          && incoming().updatedAt == request.time;
      }

      // likeCount moves by exactly 1, together with creating/deleting the caller's like doc.
      function likeChange(buildId) {
        let like = /databases/$(database)/documents/builds/$(buildId)/likes/$(request.auth.uid);
        let delta = incoming().likeCount - resource.data.likeCount;
        return signedIn()
          && changedKeys().hasOnly(['likeCount'])
          && ((delta == 1 && !exists(like) && existsAfter(like))
            || (delta == -1 && exists(like) && !existsAfter(like)));
      }

      // commentCount moves by exactly 1, together with creating/deleting the comment named by
      // lastCommentId (the comment rules check who may do that).
      function commentChange(buildId) {
        let id = incoming().lastCommentId;
        let comment = /databases/$(database)/documents/builds/$(buildId)/comments/$(id);
        let delta = incoming().commentCount - resource.data.commentCount;
        return signedIn()
          && changedKeys().hasOnly(['commentCount', 'lastCommentId'])
          && id is string && id.matches('^[A-Za-z0-9_-]{1,40}$')
          && ((delta == 1 && !exists(comment) && existsAfter(comment))
            || (delta == -1 && exists(comment) && !existsAfter(comment)));
      }

      // builds/{id}/likes/{uid}: one like per user; the doc id is the liker's uid.
      match /likes/{userId} {
        allow read: if true;
        allow create: if isUser(userId)
          && hasExactly(incoming(), ['userId', 'createdAt'])
          && incoming().userId == userId
          && incoming().createdAt == request.time
          && getAfter(buildPath(buildId)).data.likeCount
            == get(buildPath(buildId)).data.likeCount + 1;
        // Unlike (with the decrement), or clean up after the build was deleted.
        allow delete: if signedIn() && (
          !existsAfter(buildPath(buildId))
          || (request.auth.uid == userId
            && getAfter(buildPath(buildId)).data.likeCount
              == get(buildPath(buildId)).data.likeCount - 1));
        allow update: if false;
      }

      // builds/{id}/comments/{id}: signed-in users comment; authors (and admins) delete.
      match /comments/{commentId} {
        allow read: if true;
        allow create: if signedIn()
          && hasExactly(incoming(), ['authorId', 'text', 'createdAt'])
          && incoming().authorId == request.auth.uid
          && isText(incoming().text, 1000)
          && incoming().createdAt == request.time
          && getAfter(buildPath(buildId)).data.commentCount
            == get(buildPath(buildId)).data.commentCount + 1
          && getAfter(buildPath(buildId)).data.lastCommentId == commentId;
        // Delete (with the decrement), or clean up after the build was deleted.
        allow delete: if signedIn() && (
          !existsAfter(buildPath(buildId))
          || ((resource.data.authorId == request.auth.uid || isAdmin())
            && getAfter(buildPath(buildId)).data.commentCount
              == get(buildPath(buildId)).data.commentCount - 1
            && getAfter(buildPath(buildId)).data.lastCommentId == commentId));
        allow update: if false;
      }
    }

    // "Builds this user liked" is a collection-group query over likes (by userId).
    match /{path=**}/likes/{likeId} {
      allow read: if true;
    }

    // Account deletion (T18) finds a user's comments on every build with a collection-group query
    // (by authorId); comments are public anyway.
    match /{path=**}/comments/{commentId} {
      allow read: if true;
    }

    // ---- stats/{game}: community numbers (T20) -------------------------------------------------
    // Builds, authors and builds per tag, written once a day by `scripts/admin.mjs stats` (Admin SDK,
    // .github/workflows/stats.yml). Public; no client writes.

    match /stats/{game} {
      allow read: if true;
      allow write: if false;
    }

    // ---- reports/{id}: abuse reports (T10)-----------------------------------------------------
    // A signed-in user reports a build or a comment once: the doc id is `${targetId}_${uid}`, so a
    // second report is an update, which is refused. The target must exist. Admins read every report;
    // a reporter may read (and list, by reporterId) their own, so the UI can say "already reported".
    // Nobody changes reports from a client: scripts/admin.mjs resolves them with the Admin SDK. A
    // reporter may delete their own, which account deletion (T18) does.

    function reportTargetOk(reportId, r) {
      return isId(r.buildId) && (
        (r.commentId == null
          && reportId == r.buildId + '_' + request.auth.uid
          && exists(buildPath(r.buildId)))
        || (isId(r.commentId)
          && reportId == r.commentId + '_' + request.auth.uid
          && exists(/databases/$(database)/documents/builds/$(r.buildId)/comments/$(r.commentId))));
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && hasExactly(incoming(),
          ['reporterId', 'buildId', 'commentId', 'reason', 'note', 'status', 'createdAt'])
        && incoming().reporterId == request.auth.uid
        && incoming().reason in ['spam', 'offensive', 'harassment', 'other']
        && incoming().note is string && incoming().note.size() <= 500
        && incoming().note == incoming().note.trim()
        && incoming().status == 'open'
        && incoming().createdAt == request.time
        && reportTargetOk(reportId, incoming());
      allow get, list: if isAdmin()
        || (signedIn() && resource.data.reporterId == request.auth.uid);
      allow delete: if signedIn() && resource.data.reporterId == request.auth.uid;
      allow update: if false;
    }
  }
}
