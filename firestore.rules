rules_version = '2';

// Firestore security rules for data model v2 (T3). The model is documented in docs/architecture.md
// "Firestore model (v2)"; tests/rules/ covers every rule (`npm run test:rules`).
// Production still has the expired 2022 rules (deny all). Deploying this file is a T12 step, with
// the owner.
//
// Counters: `likeCount` and `commentCount` on a build only change by exactly 1, in the same batched
// write that creates or deletes the matching like/comment doc (no Cloud Functions: they need the
// paid Blaze plan). See likeChange() / commentChange() and the subcollection rules.
// `playerCount` and `finishedCount` (T36) do the same with a player's private tracking doc: see
// trackingCount() and countersMoved().
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helpers -------------------------------------------------------------------------------

    function signedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Admins are marked with a custom claim set by an admin script, never by a client-writable field.
    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function hasExactly(data, keys) {
      return data.keys().hasAll(keys) && data.keys().hasOnly(keys);
    }

    // A trimmed, non-empty string of at most `max` characters.
    function isText(value, max) {
      return value.size() >= 1 && value.size() <= max && value == value.trim();
    }

    // A document id the app generates (Firestore auto-ids) or the seed uses.
    function isId(value) {
      return value is string && value.matches('^[A-Za-z0-9_-]{1,40}$');
    }

    function buildPath(buildId) {
      return /databases/$(database)/documents/builds/$(buildId);
    }

    // ---- users/{uid}: public profile -----------------------------------------------------------
    // Email stays in Firebase Auth only; nothing private is stored in Firestore.

    match /users/{userId} {
      allow read: if true;
      allow create: if isUser(userId)
        && hasExactly(incoming(), ['displayName', 'createdAt'])
        && isText(incoming().displayName, 40)
        && incoming().createdAt == request.time;
      allow update: if isUser(userId)
        && changedKeys().hasOnly(['displayName'])
        && isText(incoming().displayName, 40);
      // Account deletion (T18): the last Firestore step before the Auth account goes.
      allow delete: if isUser(userId);

      // users/{uid}/tracking/{buildId}: the player's private progress on a build (T34). Only they
      // read or write it. Item keys and stats are the app's job beyond their shape. startedAt is set
      // by the client (progress from local storage keeps its real start) and may only move earlier
      // (merging this device's progress into the account's on sign-in).
      //
      // The build's counters (T36) move in the same batch whenever the doc's status changes: created,
      // finished, un-finished, deleted. Deleting is also allowed once the build is gone.
      match /tracking/{buildId} {
        allow read: if isUser(userId);
        allow create: if isUser(userId) && validTracking(buildId, incoming())
          && buildCounted(buildId, 0, statusOf(incoming()));
        allow update: if isUser(userId) && validTracking(buildId, incoming())
          && incoming().startedAt <= resource.data.startedAt
          && (statusOf(incoming()) == statusOf(resource.data)
            || buildCounted(buildId, statusOf(resource.data), statusOf(incoming())));
        allow delete: if isUser(userId) && (!existsAfter(buildPath(buildId))
          || buildCounted(buildId, statusOf(resource.data), 0));
      }
    }

    // A player's status on a build (T36): 0 not tracking, 1 playing, 2 finished.
    function statusOf(t) {
      return t.completedAt == null ? 1 : 2;
    }

    // The build's counters moved from status `from` to `to` (each by -1, 0 or +1), from `before` to
    // `after` (build data). Builds saved before T36 have no counters: they count from 0.
    function countersMoved(before, after, from, to) {
      return from != to
        && after.get('playerCount', 0) - before.get('playerCount', 0)
          == (to > 0 ? 1 : 0) - (from > 0 ? 1 : 0)
        && after.get('finishedCount', 0) - before.get('finishedCount', 0)
          == (to == 2 ? 1 : 0) - (from == 2 ? 1 : 0);
    }

    function buildCounted(buildId, from, to) {
      return countersMoved(get(buildPath(buildId)).data, getAfter(buildPath(buildId)).data, from, to);
    }

    // `marked` (T44: route stops marked done) is optional: docs saved before it don't have it.
    function validTracking(buildId, t) {
      return isId(buildId)
        && t.keys().hasAll(['game', 'collected', 'seen', 'stats', 'startedAt', 'updatedAt',
          'completedAt'])
        && t.keys().hasOnly(['game', 'collected', 'seen', 'marked', 'stats', 'startedAt',
          'updatedAt', 'completedAt'])
        && t.game == 'elden-ring'
        && t.collected is list && t.collected.size() <= 64
        && t.seen is list && t.seen.size() <= 64
        && (!('marked' in t) || (t.marked is list && t.marked.size() <= 64))
        && validStats(t.stats)
        && t.startedAt is timestamp
        && t.updatedAt == request.time
        && (t.completedAt == null || t.completedAt is timestamp);
    }

    // ---- builds/{id} ---------------------------------------------------------------------------
    //
    // Budget: Firestore evaluates at most 1,000 expressions per request and past that denies with a
    // bare PERMISSION_DENIED, so a build with every slot filled could fail to save with no hint why.
    // The checks below are written to evaluate as few expressions as they can (T42). What costs:
    // every operator, literal, field access and function call counts (~1 each); a function argument
    // is evaluated once, then costs 1 per use, while each `incoming()` or `request.resource.data.x`
    // re-walks its whole path, and a `let` re-evaluates its expression at every use; a list literal
    // costs one per element (a split string or a regex costs one). Hence: helpers take the data as
    // an argument; key sets are checked by size where every key is read anyway (reading a missing
    // key is an error, so it denies); a value is never type-checked when the next call already fails
    // on any other type (`l.concat([])` fails unless l is a list, `.trim()` unless it's text).
    //
    // tests/rules/budget.test.ts runs the costliest builds (create and edit, every slot filled, an
    // image, level 131 and level 1) with N padding comparisons added here and keeps HEADROOM, the
    // padding they still pass with (T42: 93 for a create, 99 for an edit; one padding is ~4
    // expressions). A new check spends some: measure it with `RULES_BUDGET=measure npm run
    // test:rules` and lower HEADROOM by what it spent. docs/firebase.md "Rules budget" has the table.

    // A player's stats on a tracking doc (not budget-bound); a build's go through validBuildStats.
    function isStat(value) {
      return value is int && value >= 1 && value <= 99;
    }

    function validStats(s) {
      return s is map
        && hasExactly(s, ['vigor', 'mind', 'end', 'str', 'dex', 'int', 'fai', 'arc'])
        && isStat(s.vigor) && isStat(s.mind) && isStat(s.end) && isStat(s.str)
        && isStat(s.dex) && isStat(s.int) && isStat(s.fai) && isStat(s.arc);
    }

    // A build's 8 stats, each an int from 1 to 99, and its level = their sum - 79, never below 1
    // (src/lib/buildMath.ts calculateLevel). One regex checks all 8 stats: each plus 100 is a
    // 3-digit int from 101 to 199 (text, null or a bool can't be added to; a float prints a dot).
    // The level path sums the stats once, whichever level.
    function validBuildStats(s, level) {
      return s.size() == 8
        && (string(s.vigor + 100) + string(s.mind + 100) + string(s.end + 100)
          + string(s.str + 100) + string(s.dex + 100) + string(s.int + 100)
          + string(s.fai + 100) + string(s.arc + 100)).matches('(1(0[1-9]|[1-9][0-9])){8}')
        && level is int
        && ((level == 1 && s.vigor + s.mind + s.end + s.str + s.dex + s.int + s.fai + s.arc <= 80)
          || (level >= 2
            && level == s.vigor + s.mind + s.end + s.str + s.dex + s.int + s.fai + s.arc - 79));
    }

    // Items are game IDs (param row IDs in src/data/er/; each field implies the file). Whether an ID
    // exists or fits its weapon is the app's job (it ignores unknown IDs). Positional lists have a
    // fixed length with null for an empty slot. Weapons and the single slots are type-checked, the
    // affinities against their keys; every other list only by length (T42 freed the budget by
    // dropping the per-entry checks of Ashes of War and arrows; docs/decisions.md "Items in builds").
    function slots6(l) {
      return l.size() == 6
        && (l[0] == null || l[0] is int) && (l[1] == null || l[1] is int)
        && (l[2] == null || l[2] is int) && (l[3] == null || l[3] is int)
        && (l[4] == null || l[4] is int) && (l[5] == null || l[5] is int);
    }

    // A weapon's affinity per slot; Standard is stored as null.
    function affinities6(l) {
      return l.size() == 6
        && 'heavy,keen,quality,fire,flame-art,lightning,sacred,magic,cold,poison,blood,occult'
          .split(',').hasAll(l.removeAll([null]));
    }

    function validEquipment(e) {
      return e.size() == 14
        && slots6(e.weapons) && affinities6(e.weaponAffinities)
        && e.weaponSkills.concat([]).size() == 6
        && e.arrows.concat([]).size() == 4
        && e.talismans.concat([]).size() <= 4
        && e.spells.concat([]).size() <= 12
        && e.tears.concat([]).size() <= 2
        && e.consumables.concat([]).size() <= 10
        && (e.helm == null || e.helm is int) && (e.chest == null || e.chest is int)
        && (e.gauntlet == null || e.gauntlet is int) && (e.leg == null || e.leg is int)
        && (e.greatRune == null || e.greatRune is int)
        && (e.spiritAsh == null || e.spiritAsh is int);
    }

    // A starting class is its CharaInitParam ID (3000 Vagabond … 3009 Wretch, 3010 Idus Knight, 3011
    // Heavy Knight: the Tarnished Pack, T52) or null for none; builds from before T8 don't have the
    // field. The class's minimum stats are the app's job (budget).
    function validStartingClass(c) {
      return c == null || (c is int && c >= 3000 && c <= 3011);
    }

    // The build image (T40): the author's pick, as an item kind (src/lib/models.ts IMAGE_KINDS) and a
    // game ID, or null for the default (the main weapon). Builds from before T40 don't have the field.
    // Whether the item is on the build is the app's job (budget): it falls back to the main weapon.
    function validImage(image) {
      return image == null
        || (image.size() == 2 && image.id is int
          && image.kind.matches(
            'weapon|helm|chest|gauntlet|leg|talisman|spell|tear|greatRune|spiritAsh'));
    }

    // The fields the owner writes (ownerEdit lists them too). Everything else is set on create or
    // changed by the counters.
    function validContent(d) {
      return isText(d.name, 80)
        && d.nameLower == d.name.lower()
        && d.description is string && d.description.size() <= 20000
        && d.tags.concat([]).size() <= 20
        && validBuildStats(d.stats, d.level)
        && validStartingClass(d.get('startingClass', null))
        && validImage(d.get('image', null))
        && validEquipment(d.equipment);
    }

    match /builds/{buildId} {
      allow read: if true;

      allow create: if signedIn() && validNewBuild(request.resource.data);

      // Every field below is read, so a missing one denies; hasOnly rules out extra ones. `image`
      // may be absent (T40), so a tab still running an older app can create builds; `startingClass`
      // (T8) may not.
      function validNewBuild(d) {
        return d.keys().hasOnly(('name,nameLower,description,tags,level,stats,equipment,'
            + 'startingClass,image,ownerId,game,likeCount,commentCount,playerCount,finishedCount,'
            + 'createdAt,updatedAt').split(','))
          && 'startingClass' in d
          && d.ownerId == request.auth.uid
          && d.game == 'elden-ring'
          && validContent(d)
          && [d.likeCount, d.commentCount, d.playerCount, d.finishedCount] == [0, 0, 0, 0]
          && d.createdAt == request.time
          && d.updatedAt == request.time;
      }

      allow update: if ownerEdit(request.resource.data) || likeChange(buildId)
        || commentChange(buildId) || trackingCount(buildId);

      // Likes and comments are deleted afterwards (see the orphan rules below).
      allow delete: if signedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());

      // The owner edits the content and must bump updatedAt; never ownerId, game, counts or createdAt.
      function ownerEdit(d) {
        return signedIn()
          && resource.data.ownerId == request.auth.uid
          && changedKeys().hasOnly(
            'name,nameLower,description,tags,level,stats,equipment,startingClass,image,updatedAt'
              .split(','))
          && validContent(d)
          && d.updatedAt == request.time;
      }

      // likeCount moves by exactly 1, together with creating/deleting the caller's like doc.
      function likeChange(buildId) {
        let like = /databases/$(database)/documents/builds/$(buildId)/likes/$(request.auth.uid);
        let delta = incoming().likeCount - resource.data.likeCount;
        return signedIn()
          && changedKeys().hasOnly(['likeCount'])
          && ((delta == 1 && !exists(like) && existsAfter(like))
            || (delta == -1 && exists(like) && !existsAfter(like)));
      }

      // commentCount moves by exactly 1, together with creating/deleting the comment named by
      // lastCommentId (the comment rules check who may do that).
      function commentChange(buildId) {
        let id = incoming().lastCommentId;
        let comment = /databases/$(database)/documents/builds/$(buildId)/comments/$(id);
        let delta = incoming().commentCount - resource.data.commentCount;
        return signedIn()
          && changedKeys().hasOnly(['commentCount', 'lastCommentId'])
          && id is string && id.matches('^[A-Za-z0-9_-]{1,40}$')
          && ((delta == 1 && !exists(comment) && existsAfter(comment))
            || (delta == -1 && exists(comment) && !existsAfter(comment)));
      }

      // playerCount / finishedCount move with the caller's own tracking doc on this build (T36).
      function trackingCount(buildId) {
        let t = /databases/$(database)/documents/users/$(request.auth.uid)/tracking/$(buildId);
        return signedIn()
          && changedKeys().hasOnly(['playerCount', 'finishedCount'])
          && countersMoved(resource.data, incoming(),
            exists(t) ? statusOf(get(t).data) : 0,
            existsAfter(t) ? statusOf(getAfter(t).data) : 0);
      }

      // builds/{id}/likes/{uid}: one like per user; the doc id is the liker's uid.
      match /likes/{userId} {
        allow read: if true;
        allow create: if isUser(userId)
          && hasExactly(incoming(), ['userId', 'createdAt'])
          && incoming().userId == userId
          && incoming().createdAt == request.time
          && getAfter(buildPath(buildId)).data.likeCount
            == get(buildPath(buildId)).data.likeCount + 1;
        // Unlike (with the decrement), or clean up after the build was deleted.
        allow delete: if signedIn() && (
          !existsAfter(buildPath(buildId))
          || (request.auth.uid == userId
            && getAfter(buildPath(buildId)).data.likeCount
              == get(buildPath(buildId)).data.likeCount - 1));
        allow update: if false;
      }

      // builds/{id}/comments/{id}: signed-in users comment; authors (and admins) delete.
      match /comments/{commentId} {
        allow read: if true;
        allow create: if signedIn()
          && hasExactly(incoming(), ['authorId', 'text', 'createdAt'])
          && incoming().authorId == request.auth.uid
          && isText(incoming().text, 1000)
          && incoming().createdAt == request.time
          && getAfter(buildPath(buildId)).data.commentCount
            == get(buildPath(buildId)).data.commentCount + 1
          && getAfter(buildPath(buildId)).data.lastCommentId == commentId;
        // Delete (with the decrement), or clean up after the build was deleted.
        allow delete: if signedIn() && (
          !existsAfter(buildPath(buildId))
          || ((resource.data.authorId == request.auth.uid || isAdmin())
            && getAfter(buildPath(buildId)).data.commentCount
              == get(buildPath(buildId)).data.commentCount - 1
            && getAfter(buildPath(buildId)).data.lastCommentId == commentId));
        allow update: if false;
      }
    }

    // "Builds this user liked" is a collection-group query over likes (by userId).
    match /{path=**}/likes/{likeId} {
      allow read: if true;
    }

    // Account deletion (T18) finds a user's comments on every build with a collection-group query
    // (by authorId); comments are public anyway.
    match /{path=**}/comments/{commentId} {
      allow read: if true;
    }

    // ---- stats/{game}: community numbers (T20) -------------------------------------------------
    // Builds, authors and builds per tag, written once a day by `scripts/admin.mjs stats` (Admin SDK,
    // .github/workflows/stats.yml). Public; no client writes.

    match /stats/{game} {
      allow read: if true;
      allow write: if false;
    }

    // ---- reports/{id}: abuse reports (T10)-----------------------------------------------------
    // A signed-in user reports a build or a comment once: the doc id is `${targetId}_${uid}`, so a
    // second report is an update, which is refused. The target must exist. Admins read every report;
    // a reporter may read (and list, by reporterId) their own, so the UI can say "already reported".
    // Nobody changes reports from a client: scripts/admin.mjs resolves them with the Admin SDK. A
    // reporter may delete their own, which account deletion (T18) does.

    function reportTargetOk(reportId, r) {
      return isId(r.buildId) && (
        (r.commentId == null
          && reportId == r.buildId + '_' + request.auth.uid
          && exists(buildPath(r.buildId)))
        || (isId(r.commentId)
          && reportId == r.commentId + '_' + request.auth.uid
          && exists(/databases/$(database)/documents/builds/$(r.buildId)/comments/$(r.commentId))));
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && hasExactly(incoming(),
          ['reporterId', 'buildId', 'commentId', 'reason', 'note', 'status', 'createdAt'])
        && incoming().reporterId == request.auth.uid
        && incoming().reason in ['spam', 'offensive', 'harassment', 'other']
        && incoming().note is string && incoming().note.size() <= 500
        && incoming().note == incoming().note.trim()
        && incoming().status == 'open'
        && incoming().createdAt == request.time
        && reportTargetOk(reportId, incoming());
      allow get, list: if isAdmin()
        || (signedIn() && resource.data.reporterId == request.auth.uid);
      allow delete: if signedIn() && resource.data.reporterId == request.auth.uid;
      allow update: if false;
    }
  }
}
